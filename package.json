{
	"name": "subresources",
	"version": "3.0.2",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sidvishnoi/subresources.git"
	},
	"license": "MIT",
	"author": "Sid Vishnoi <sidvishnoi8@gmail.com> (https://sidvishnoi.com)",
	"main": "index.js",
	"types": "./dist/types.d.ts",
	"scripts": {
		"prepare": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/dom.d.ts",
			"import": "./dist/dom.js"
		},
		"./dom": {
			"types": "./dist/dom.d.ts",
			"import": "./dist/dom.js"
		},
		"./network": {
			"types": "./dist/network.d.ts",
			"import": "./dist/network.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		}
	},
	"type": "module",
	"dependencies": {
		"puppeteer": "^25"
	},
	"packageManager": "pnpm@12.18.0",
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "^7.0"
	}
}
